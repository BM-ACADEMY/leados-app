# LeadOS — Environment Configuration
# Copy this to .env and fill in all YOUR_ values
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── SERVER ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
PORTAL_URL=https://app.abmgroups.so

# ── DATABASE ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leados_db
DB_USER=leados_user
DB_PASS=LeadOS_DB@2026

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=PASTE_64_CHAR_RANDOM_STRING_HERE

# ── WHATSAPP / META ───────────────────────────────────────
WA_VERIFY_TOKEN=leados_verify_abm2026
META_PAGE_ACCESS_TOKEN=YOUR_META_PAGE_ACCESS_TOKEN
META_APP_ID=YOUR_META_APP_ID
META_EMBEDDED_SIGNUP_CONFIG_ID=YOUR_FACEBOOK_LOGIN_FOR_BUSINESS_CONFIGURATION_ID
WA_BUSINESS_ACCOUNT_ID=YOUR_WA_BUSINESS_ACCOUNT_ID
# Optional only for single-WABA operation above. Required to discover and sync
# every owned/client WABA shown in Meta WhatsApp Inventory.
META_BUSINESS_ID=YOUR_META_BUSINESS_PORTFOLIO_ID

# ── OPENAI ────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-YOUR_NEW_KEY
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MODELS=google/gemini-2.5-flash-lite
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_REQUEST_TIMEOUT_MS=12000
OPENROUTER_SITE_URL=https://leados-app.abmgroups.org
OPENROUTER_APP_NAME=LeadOS

# ── RAZORPAY ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY
RAZORPAY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── INTERNAL (n8n calls backend with this key) ────────────
INTERNAL_API_KEY=leados_internal_2026

# ── n8n (optional — backend forwards WA messages to n8n) ──
N8N_WEBHOOK_URL=https://n8n.abmgroups.so/webhook/whatsapp-incoming
# AllianceOS isolated WhatsApp Inbox
# Phone Number ID shown in Meta WhatsApp Manager. Do not use the LeadOS number.
ALLIANCE_WA_PHONE_NUMBER_ID=
ALLIANCE_WA_ACCESS_TOKEN=
ALLIANCE_WA_VERIFY_TOKEN=
# Public HTTPS API origin used by Meta to download outbound media.
PUBLIC_API_URL=https://leados-api.abmgroups.org

# AllianceOS Zoho email sender and inbound reply mailbox
ALLIANCE_EMAIL_PROVIDER=zoho
ALLIANCE_EMAIL_FROM=admin@abmgroups.org
ALLIANCE_EMAIL_FROM_NAME=ABM Groups
ALLIANCE_EMAIL_SMTP_HOST=smtp.zoho.in
ALLIANCE_EMAIL_SMTP_PORT=465
ALLIANCE_EMAIL_SMTP_SECURE=true
ALLIANCE_EMAIL_SMTP_USER=admin@abmgroups.org
ALLIANCE_EMAIL_SMTP_PASSWORD=
ALLIANCE_EMAIL_REPLY_TO=admin@abmgroups.org
ALLIANCE_EMAIL_IMAP_HOST=imap.zoho.in
ALLIANCE_EMAIL_IMAP_PORT=993
ALLIANCE_EMAIL_IMAP_SECURE=true
ALLIANCE_EMAIL_IMAP_USER=admin@abmgroups.org
# Optional: defaults to ALLIANCE_EMAIL_SMTP_PASSWORD when omitted.
ALLIANCE_EMAIL_IMAP_PASSWORD=
