# LeadOS — Environment Configuration
# Copy this to .env and fill in all YOUR_ values
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── SERVER ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
PORTAL_URL=https://app.abmgroups.so

# ── DATABASE ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leados_db
DB_USER=leados_user
DB_PASS=LeadOS_DB@2026

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=PASTE_64_CHAR_RANDOM_STRING_HERE

# ── WHATSAPP / META ───────────────────────────────────────
WA_VERIFY_TOKEN=leados_verify_abm2026
META_PAGE_ACCESS_TOKEN=YOUR_META_PAGE_ACCESS_TOKEN
META_APP_ID=YOUR_META_APP_ID
META_EMBEDDED_SIGNUP_CONFIG_ID=YOUR_FACEBOOK_LOGIN_FOR_BUSINESS_CONFIGURATION_ID
WA_BUSINESS_ACCOUNT_ID=YOUR_WA_BUSINESS_ACCOUNT_ID
# Optional only for single-WABA operation above. Required to discover and sync
# every owned/client WABA shown in Meta WhatsApp Inventory.
META_BUSINESS_ID=YOUR_META_BUSINESS_PORTFOLIO_ID

# ── OPENAI ────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-YOUR_NEW_KEY
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MODELS=google/gemini-2.5-flash-lite
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_REQUEST_TIMEOUT_MS=12000
OPENROUTER_SITE_URL=https://leados-app.abmgroups.org
OPENROUTER_APP_NAME=LeadOS

# ── RAZORPAY ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY
RAZORPAY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── INTERNAL (n8n calls backend with this key) ────────────
INTERNAL_API_KEY=leados_internal_2026

# ── n8n (optional — backend forwards WA messages to n8n) ──
N8N_WEBHOOK_URL=https://n8n.abmgroups.so/webhook/whatsapp-incoming
