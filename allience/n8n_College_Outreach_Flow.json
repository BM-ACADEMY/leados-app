{
  "name": "AllianceOS - College Outreach Sequence",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "New Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "allianceos-college-lead",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "typeVersion": 1
    },
    {
      "id": "send-wa-m1",
      "name": "Send WA Message 1",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.META_API_URL}}/{{$env.META_PHONE_NUMBER_ID}}/messages",
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "Authorization",
          "value": "=Bearer {{$env.META_ACCESS_TOKEN}}"
        },
        "bodyParametersJson": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone}}\",\"type\":\"template\",\"template\":{\"name\":\"ct_college_intro\",\"language\":{\"code\":\"en\"},\"components\":[{\"type\":\"body\",\"parameters\":[{\"type\":\"text\",\"text\":\"{{$json.contact_name}}\"},{\"type\":\"text\",\"text\":\"{{$json.name}}\"}]}]}}"
      },
      "typeVersion": 1
    },
    {
      "id": "update-db-m1",
      "name": "Update DB - M1 Sent",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.API_URL}}/api/pipeline/{{$json.org_id}}/stage",
        "bodyParametersJson": "{\"stage\":\"contacted\",\"outreach_type\":\"WA_M1\",\"sent_at\":\"{{$now}}\"}"
      },
      "typeVersion": 1
    },
    {
      "id": "wait-48h",
      "name": "Wait 48 Hours",
      "type": "n8n-nodes-base.wait",
      "position": [
        960,
        300
      ],
      "parameters": {
        "resume": "timeInterval",
        "unit": "hours",
        "amount": 48
      },
      "typeVersion": 1
    },
    {
      "id": "check-replied",
      "name": "Check If Replied",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{$env.API_URL}}/api/leads/{{$json.org_id}}/replied"
      },
      "typeVersion": 1
    },
    {
      "id": "if-replied",
      "name": "Replied?",
      "type": "n8n-nodes-base.if",
      "position": [
        1440,
        300
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.replied}}",
              "value2": true
            }
          ]
        }
      },
      "typeVersion": 1
    },
    {
      "id": "telegram-alert",
      "name": "Telegram Alert - Reply",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1680,
        200
      ],
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=\ud83c\udfaf COLLEGE REPLIED\\n{{$json.name}} - {{$json.district}}\\nContact: {{$json.contact_name}}\\nPhone: {{$json.phone}}\\nScore: {{$json.score}}\\n\\nCheck AllianceOS \u2192 Replied stage"
      },
      "typeVersion": 1
    },
    {
      "id": "send-wa-m2",
      "name": "Send WA Message 2",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1680,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.META_API_URL}}/{{$env.META_PHONE_NUMBER_ID}}/messages",
        "bodyParametersJson": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone}}\",\"type\":\"template\",\"template\":{\"name\":\"ct_college_followup1\",\"language\":{\"code\":\"en\"},\"components\":[{\"type\":\"body\",\"parameters\":[{\"type\":\"text\",\"text\":\"{{$json.name}}\"}]}]}}"
      },
      "typeVersion": 1
    },
    {
      "id": "wait-72h-m2",
      "name": "Wait 72 Hours After M2",
      "type": "n8n-nodes-base.wait",
      "position": [
        1920,
        400
      ],
      "parameters": {
        "resume": "timeInterval",
        "unit": "hours",
        "amount": 72
      },
      "typeVersion": 1
    },
    {
      "id": "send-wa-m3",
      "name": "Send WA Message 3 (Urgency)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2160,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.META_API_URL}}/{{$env.META_PHONE_NUMBER_ID}}/messages",
        "bodyParametersJson": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone}}\",\"type\":\"template\",\"template\":{\"name\":\"ct_college_urgency\",\"language\":{\"code\":\"en\"},\"components\":[{\"type\":\"body\",\"parameters\":[{\"type\":\"text\",\"text\":\"{{$json.name}}\"},{\"type\":\"text\",\"text\":\"{{$json.district}}\"}]}]}}"
      },
      "typeVersion": 1
    },
    {
      "id": "wait-72h-m3",
      "name": "Wait 72 Hours After M3",
      "type": "n8n-nodes-base.wait",
      "position": [
        2400,
        400
      ],
      "parameters": {
        "resume": "timeInterval",
        "unit": "hours",
        "amount": 72
      },
      "typeVersion": 1
    },
    {
      "id": "send-wa-m4",
      "name": "Send WA Message 4 (Final)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2640,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.META_API_URL}}/{{$env.META_PHONE_NUMBER_ID}}/messages",
        "bodyParametersJson": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone}}\",\"type\":\"template\",\"template\":{\"name\":\"ct_college_final\",\"language\":{\"code\":\"en\"}}}"
      },
      "typeVersion": 1
    },
    {
      "id": "mark-done",
      "name": "Mark Sequence Done",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2880,
        400
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.API_URL}}/api/pipeline/{{$json.org_id}}/stage",
        "bodyParametersJson": "{\"stage\":\"contacted\",\"n8n_status\":\"SEQUENCE_DONE\"}"
      },
      "typeVersion": 1
    }
  ],
  "connections": {
    "New Lead Webhook": {
      "main": [
        [
          "Send WA Message 1"
        ]
      ]
    },
    "Send WA Message 1": {
      "main": [
        [
          "Update DB - M1 Sent"
        ]
      ]
    },
    "Update DB - M1 Sent": {
      "main": [
        [
          "Wait 48 Hours"
        ]
      ]
    },
    "Wait 48 Hours": {
      "main": [
        [
          "Check If Replied"
        ]
      ]
    },
    "Check If Replied": {
      "main": [
        [
          "Replied?"
        ]
      ]
    },
    "Replied?": {
      "main": [
        [
          "Telegram Alert - Reply"
        ],
        [
          "Send WA Message 2"
        ]
      ]
    },
    "Send WA Message 2": {
      "main": [
        [
          "Wait 72 Hours After M2"
        ]
      ]
    },
    "Wait 72 Hours After M2": {
      "main": [
        [
          "Send WA Message 3 (Urgency)"
        ]
      ]
    },
    "Send WA Message 3 (Urgency)": {
      "main": [
        [
          "Wait 72 Hours After M3"
        ]
      ]
    },
    "Wait 72 Hours After M3": {
      "main": [
        [
          "Send WA Message 4 (Final)"
        ]
      ]
    },
    "Send WA Message 4 (Final)": {
      "main": [
        [
          "Mark Sequence Done"
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "description": "AllianceOS College Outreach \u2014 fires WA M1-M4 with 48-72hr gaps. Stops on reply.",
    "templateCredsSetupCompleted": false
  }
}