    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nlet source = item.source;\nconst waChange = item.entry?.[0]?.changes?.[0]?.value || item;\n\n// Stop processing if this is just a status update (delivery receipt, read receipt)\nif (waChange?.statuses?.[0]) {\n  throw new Error('STATUS_UPDATE_IGNORED');\n}\n\nif (!source && (item.object === 'whatsapp_business_account' || waChange?.messages?.[0])) {\n  source = 'whatsapp';\n}\nlet lead = {};\n\nswitch (source) {\n  case 'whatsapp': {\n    const msgObj = item.payload?.message || waChange?.messages?.[0]?.text?.body || waChange?.messages?.[0]?.button?.text || '';\n    const phoneObj = item.payload?.phone || waChange?.messages?.[0]?.from || waChange?.contacts?.[0]?.wa_id || item.phone || '';\n    const nameObj = item.payload?.name || waChange?.contacts?.[0]?.profile?.name || phoneObj;\n    const phoneNumberIdObj = item.payload?.phone_number_id || waChange?.metadata?.phone_number_id || '';\n    if (!phoneObj) throw new Error('MISSING_PHONE');\n    lead = { name: nameObj, phone: phoneObj, email: item.payload?.email || item.email || '', message: typeof msgObj === 'object' ? JSON.stringify(msgObj) : (msgObj || ''), source: 'whatsapp', phone_number_id: phoneNumberIdObj, lead_id: item.lead_id || item.payload?.lead_id };\n    break;\n  }\n  case 'meta_ads':\n    lead = { name: item.payload?.full_name || '', phone: item.payload?.phone || '', email: item.payload?.email || '', source: 'meta_ads', campaign_id: item.payload?.campaign_id || '', ad_id: item.payload?.ad_id || '', lead_ad_form_id: item.payload?.form_id || '' };\n    break;\n  case 'website':\n    lead = { name: item.payload?.name || '', phone: item.payload?.phone || '', email: item.payload?.email || '', source: 'website', message: item.payload?.message || '' };\n    break;\n  case 'email':\n    lead = { name: item.payload?.name || '', email: item.payload?.email || '', source: 'email', message: item.payload?.body || '' };\n    break;\n  case 'bulk_whatsapp':\n    lead = { name: item.payload?.name || '', phone: item.payload?.phone || '', source: 'bulk_whatsapp', message: item.payload?.message || '', campaign_id: item.payload?.campaign_id || '' };\n    break;\n  default:\n    lead = { source: 'unknown', raw: item };\n}\nreturn [{ json: lead }];",
        "mode": "runOnceForAllItems"
      },
