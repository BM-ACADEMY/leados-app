    {
      "parameters": {
        "jsCode": "// Expects each input branch merged upstream via a Merge node in real n8n;\n// here we assume a combined payload is available from /api/reports/reminder-bundle\nconst item = $input.item.json;\nreturn [{ json: item }];",
        "mode": "runOnceForAllItems"
      },
      "id": "9482f09d-33c4-4181-a462-7192151a4b01",
      "name": "Group By Salesperson",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst owners = item.owners || [];\nconst summaries = owners.map(o => ({\n  owner: o.owner,\n  text: `Today's Tasks – ${o.brand}: ${o.followup_count||0} Follow-ups, ${o.call_count||0} Calls, ${o.payment_count||0} Payments, ${o.hot_count||0} HOT Leads, ${o.overdue_count||0} Overdue.`\n}));\nreturn summaries.map(s => ({ json: s }));",
        "mode": "runOnceForAllItems"
      },
      "id": "7c726376-5da0-45d2-93f6-a29357feb9d3",
      "name": "Generate Salesperson Summaries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        -60
      ]
    },
