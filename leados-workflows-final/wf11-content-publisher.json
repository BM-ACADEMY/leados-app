{
  "name": "WF11 - Scheduled Content Auto-Publisher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "node-content-cron",
      "name": "Every Hour Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cq.*, bsa.instagram_business_id, bsa.facebook_page_id, bsa.account_id FROM content_queue cq LEFT JOIN brand_social_accounts bsa ON bsa.brand_name = cq.brand_name AND bsa.platform = 'instagram' AND bsa.is_active = true WHERE cq.status IN ('APPROVED', 'approved') AND cq.scheduled_at <= NOW() AND cq.scheduled_at > NOW() - INTERVAL '2 hours' ORDER BY cq.scheduled_at ASC LIMIT 10",
        "additionalFields": {}
      },
      "id": "node-get-due-posts",
      "name": "Get Due Posts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "credentials": {
        "postgres": {
          "name": "LeadOS DB"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $input.all().length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "node-has-posts",
      "name": "Any Posts Due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "node-loop-posts",
      "name": "Loop Each Post",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        650,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const post = $input.first().json;\n\n// Check if credentials are present (fields from SQL join)\nconst hasInstagramCreds = post.platform === 'instagram' && post.instagram_business_id;\nconst hasFacebookCreds = post.platform === 'facebook' && post.facebook_page_id;\nconst isGeneralAutoPublish = ['GMB', 'WhatsApp Status'].includes(post.platform);\n\nconst canAutoPublish = isGeneralAutoPublish || hasInstagramCreds || hasFacebookCreds;\nconst isMetaPlatform = ['instagram', 'facebook'].includes(post.platform);\n\nreturn [{ json: {\n  ...post,\n  can_auto_publish: canAutoPublish,\n  is_meta_platform: isMetaPlatform,\n  note: canAutoPublish\n    ? (isMetaPlatform ? 'Triggering backend Meta auto-publisher...' : 'Will attempt auto-publish')\n    : `Manual action needed: Log in to ${post.platform} and publish post ID ${post.id}`\n}}];"
      },
      "id": "node-decide-publish",
      "name": "Decide Publish Method",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.can_auto_publish }}",
              "value2": true
            },
            {
              "value1": "={{ $json.is_meta_platform }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-check-meta-platform",
      "name": "Is Meta Auto Publish?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1050,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:3500/api/content/{{ $json.id }}/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "leados_internal_2026"
            }
          ]
        },
        "options": {}
      },
      "id": "node-publish-meta-backend",
      "name": "Publish via Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.can_auto_publish }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-check-other-auto",
      "name": "Is Other Auto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1250,
        500
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_queue SET status = 'published' WHERE id = $1",
        "additionalFields": {
          "queryParams": "={{ $json.id }}"
        }
      },
      "id": "node-mark-published",
      "name": "Mark as Published",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1450,
        450
      ],
      "credentials": {
        "postgres": {
          "name": "LeadOS DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO notifications (recipient_id, client_id, type, title, message, priority, sent_at) SELECT tm.id, $1, 'content', 'Post Published', $2, 'normal', NOW() FROM team_members tm WHERE tm.role IN ('admin', 'super_admin') LIMIT 1",
        "additionalFields": {
          "queryParams": "={{ $json.client_id }},='Post published on '+ $json.platform +': '+ LEFT($json.content, 60)+'...'"
        }
      },
      "id": "node-notify-published",
      "name": "Notify Team of Published Post",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1650,
        400
      ],
      "credentials": {
        "postgres": {
          "name": "LeadOS DB"
        }
      }
    }
  ],
  "connections": {
    "Every Hour Check": {
      "main": [
        [
          {
            "node": "Get Due Posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Due Posts": {
      "main": [
        [
          {
            "node": "Any Posts Due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Posts Due?": {
      "main": [
        [],
        [
          {
            "node": "Loop Each Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Each Post": {
      "main": [
        [
          {
            "node": "Decide Publish Method",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decide Publish Method": {
      "main": [
        [
          {
            "node": "Is Meta Auto Publish?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Meta Auto Publish?": {
      "main": [
        [
          {
            "node": "Publish via Backend",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Is Other Auto?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish via Backend": {
      "main": [
        [
          {
            "node": "Notify Team of Published Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Other Auto?": {
      "main": [
        [
          {
            "node": "Mark as Published",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Loop Each Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark as Published": {
      "main": [
        [
          {
            "node": "Notify Team of Published Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Team of Published Post": {
      "main": [
        [
          {
            "node": "Loop Each Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "id": "wf11-content-publisher"
}