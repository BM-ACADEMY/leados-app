{
  "name": "WF13 - Campaign Auto-End and Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "node-campaign-cron",
      "name": "Daily Midnight Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT gc.*, c.phone_number_id, c.wa_access_token FROM gmb_campaigns gc JOIN clients c ON gc.client_id = c.id WHERE gc.is_active = true AND gc.end_date <= CURRENT_DATE",
        "additionalFields": {}
      },
      "id": "node-get-expired",
      "name": "Get Expired Active Campaigns",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "credentials": {
        "postgres": {
          "name": "LeadOS DB"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $input.all().length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "node-has-expired",
      "name": "Any Expired Campaigns?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "node-loop-camps",
      "name": "Loop Each Campaign",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        800,
        400
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE gmb_campaigns SET is_active = false, report_generated = true WHERE id = $1",
        "additionalFields": {
          "queryParams": "={{ $json.id }}"
        }
      },
      "id": "node-deactivate",
      "name": "Deactivate Campaign",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1000,
        400
      ],
      "credentials": {
        "postgres": {
          "name": "LeadOS DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as leads_during_campaign FROM leads WHERE client_id = $1 AND created_at BETWEEN $2 AND $3",
        "additionalFields": {
          "queryParams": "={{ $json.client_id }},={{ $json.start_date }},={{ $json.end_date }}"
        }
      },
      "id": "node-campaign-leads",
      "name": "Count Campaign Leads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1000,
        540
      ],
      "credentials": {
        "postgres": {
          "name": "LeadOS DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const camp = $('Loop Each Campaign').item.json;\nconst leads = $('Count Campaign Leads').first().json;\n\nconst start = new Date(camp.start_date).toLocaleDateString('en-IN');\nconst end = new Date(camp.end_date).toLocaleDateString('en-IN');\n\nconst report = `\ud83d\ude80 Campaign Ended \u2014 Report\\n\\n` +\n  `Campaign: ${camp.name}\\n` +\n  `Period: ${start} \u2192 ${end}\\n` +\n  `CTA Type: ${camp.cta_type}\\n` +\n  `Post Frequency: ${camp.post_frequency}\\n\\n` +\n  `Results:\\n` +\n  `\u2022 Leads generated: ${leads.leads_during_campaign || 0}\\n` +\n  `\u2022 WA Broadcast: ${camp.wa_broadcast_active ? 'Active' : 'Not used'}\\n\\n` +\n  `View full analytics: https://leados-app.abmgroups.org`;\n\nreturn [{ json: {\n  message: report,\n  phone_number_id: camp.phone_number_id,\n  wa_access_token: camp.wa_access_token,\n  camp_name: camp.name\n}}];"
      },
      "id": "node-build-camp-report",
      "name": "Build Campaign Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        470
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $json.phone_number_id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.wa_access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: '919403892971', type: 'text', text: { body: $json.message } }) }}"
      },
      "id": "node-send-camp-report",
      "name": "Send Campaign Report to Kamar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1400,
        470
      ]
    }
  ],
  "connections": {
    "Daily Midnight Check": {
      "main": [
        [
          {
            "node": "Get Expired Active Campaigns",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Expired Active Campaigns": {
      "main": [
        [
          {
            "node": "Any Expired Campaigns?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Expired Campaigns?": {
      "main": [
        [],
        [
          {
            "node": "Loop Each Campaign",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Each Campaign": {
      "main": [
        [
          {
            "node": "Deactivate Campaign",
            "type": "main",
            "index": 0
          },
          {
            "node": "Count Campaign Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deactivate Campaign": {
      "main": [
        [
          {
            "node": "Build Campaign Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Count Campaign Leads": {
      "main": [
        [
          {
            "node": "Build Campaign Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Campaign Report": {
      "main": [
        [
          {
            "node": "Send Campaign Report to Kamar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Campaign Report to Kamar": {
      "main": [
        [
          {
            "node": "Loop Each Campaign",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "id": "wf13-campaign-auto-end"
}