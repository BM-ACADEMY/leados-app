{
  "name": "WF4 - Hot Lead Alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hot-lead-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-hot",
      "name": "Hot Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "hot-lead-alert"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, c.name as brand_name, u.name as agent_name\nFROM leads l\nLEFT JOIN clients c ON l.client_id = c.id\nLEFT JOIN users u ON l.assigned_to = u.id\nWHERE l.id = {{ $json.body.lead_id || $json.lead_id }}",
        "options": {}
      },
      "id": "get-hot-lead",
      "name": "Get Hot Lead Details",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "name": "LeadOS DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $json;\nconst portalUrl = 'https://leados-app.abmgroups.org';\n\nconst alertMsg = `\ud83d\udd25 HOT LEAD ALERT!\n\n\ud83d\udc64 Name: ${lead.name}\n\ud83d\udcf1 Phone: ${lead.phone}\n\ud83c\udfe2 Brand: ${lead.brand_name || 'Unknown'}\n\u2b50 Score: ${lead.score}/100\n\ud83d\udca1 Interest: ${lead.interest || 'Not specified'}\n\n\u26a1 This lead is ready to convert!\n\n\ud83d\udd17 View in portal: ${portalUrl}`;\n\nreturn [{ json: { lead, alertMsg } }];"
      },
      "id": "build-alert",
      "name": "Build Alert Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.phone_number_id, c.wa_access_token\nFROM clients c\nWHERE c.name ILIKE '%Academy%'\n  AND c.wa_access_token IS NOT NULL\nLIMIT 1",
        "options": {}
      },
      "id": "get-admin-wa",
      "name": "Get Admin WA Creds",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        300
      ],
      "credentials": {
        "postgres": {
          "name": "LeadOS DB"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $json.phone_number_id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $json.wa_access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"919403892971\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"{{ $('Build Alert Message').first().json.alertMsg }}\" }\n}",
        "options": {}
      },
      "id": "send-alert",
      "name": "Send Alert to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
    "Hot Lead Webhook": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Hot Lead Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Hot Lead Details": {
      "main": [
        [
          {
            "node": "Build Alert Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Alert Message": {
      "main": [
        [
          {
            "node": "Get Admin WA Creds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Admin WA Creds": {
      "main": [
        [
          {
            "node": "Send Alert to Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "LeadOS"
    }
  ]
}